{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/sample/sample.schema.json",
  "title": "CloudEyes Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "created_at",
    "provider",
    "product",
    "machine",
    "protocol",
    "measurements",
    "quality"
  ],
  "$defs": {
    "metric": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cloudeyes.dev/schemas/measurement/metric.schema.json",
      "title": "CloudEyes Metric",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "neutral"
          ]
        }
      }
    },
    "measurement": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cloudeyes.dev/schemas/measurement/measurement.schema.json",
      "title": "CloudEyes Measurement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "tool",
        "tool_version",
        "profile",
        "protocol_version",
        "started_at",
        "finished_at",
        "status",
        "metrics",
        "raw_output_path",
        "error"
      ],
      "properties": {
        "measurement_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "skipped"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://cloudeyes.dev/schemas/measurement/metric.schema.json",
            "title": "CloudEyes Metric",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "unit",
              "direction"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "type": "string",
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "neutral"
                ]
              }
            }
          }
        },
        "raw_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "protocol": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cloudeyes.dev/schemas/protocol/manifest.schema.json",
      "title": "CloudEyes Protocol Identity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "fingerprint"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "name",
        "country_code"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "plan",
        "region",
        "zone"
      ],
      "properties": {
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_type",
        "cpu_count",
        "memory_bytes",
        "architecture"
      ],
      "properties": {
        "machine_type": {
          "type": "string",
          "minLength": 1
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cloudeyes.dev/schemas/protocol/manifest.schema.json",
      "title": "CloudEyes Protocol Identity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "fingerprint"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cloudeyes.dev/schemas/measurement/measurement.schema.json",
        "title": "CloudEyes Measurement",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_id",
          "tool",
          "tool_version",
          "profile",
          "protocol_version",
          "started_at",
          "finished_at",
          "status",
          "metrics",
          "raw_output_path",
          "error"
        ],
        "properties": {
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "protocol_version": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "skipped"
            ]
          },
          "metrics": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://cloudeyes.dev/schemas/measurement/metric.schema.json",
              "title": "CloudEyes Metric",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit",
                "direction"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "higher_is_better",
                    "lower_is_better",
                    "neutral"
                  ]
                }
              }
            }
          },
          "raw_output_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "warnings",
        "errors"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "valid_with_warnings",
            "invalid"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
