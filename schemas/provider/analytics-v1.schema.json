{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/provider/analytics-v1.schema.json",
  "title": "CloudEyes Provider Analytics Bundle v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_sample_count",
    "analyzed_sample_count",
    "excluded_sample_ids",
    "provider_count",
    "providers",
    "peer_group_count",
    "pricing_quote_count",
    "normalized_pricing_evidence_count",
    "unmatched_pricing_quote_ids",
    "value_peer_group_count"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "analyzed_sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_sample_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provider_count": {
      "type": "integer",
      "minimum": 0
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerAnalytics"
      }
    },
    "peer_group_count": {
      "type": "integer",
      "minimum": 0
    },
    "pricing_quote_count": {
      "type": "integer",
      "minimum": 0
    },
    "normalized_pricing_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_pricing_quote_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "value_peer_group_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "level",
        "rule_id",
        "summary",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "evidence",
            "consistency",
            "reliability",
            "performance",
            "value"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "assessed",
            "not_assessed"
          ]
        },
        "level": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "assessed"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_assessed"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "message",
        "rule_id",
        "evidence_refs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "strength",
            "limitation",
            "observation"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "cohort_count",
        "profile_count",
        "profiles",
        "coverage_ratio",
        "successful_measurement_ratio",
        "dimensions"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "cohort_count": {
          "type": "integer",
          "minimum": 0
        },
        "profile_count": {
          "type": "integer",
          "minimum": 0
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "successful_measurement_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        }
      }
    },
    "providerAnalytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analytics_id",
        "generated_at",
        "provider_id",
        "provider_name",
        "evidence",
        "scorecard",
        "explanations",
        "peer_comparisons",
        "pricing_evidence",
        "value_comparisons"
      ],
      "properties": {
        "schema_version": {
          "const": "1.2.0"
        },
        "analytics_id": {
          "type": "string",
          "pattern": "^provider-analytics-[0-9a-f]{16}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/providerReport"
        },
        "scorecard": {
          "$ref": "#/$defs/scorecard"
        },
        "explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explanation"
          }
        },
        "peer_comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peerComparison"
          }
        },
        "pricing_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pricingEvidence"
          }
        },
        "value_comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueComparison"
          }
        }
      }
    },
    "providerReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "generated_at",
        "provider_id",
        "provider_name",
        "total_samples",
        "cohort_count",
        "overall_confidence",
        "gaps",
        "cohorts"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "total_samples": {
          "type": "integer",
          "minimum": 1
        },
        "cohort_count": {
          "type": "integer",
          "minimum": 1
        },
        "overall_confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cohorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cohort_id",
              "cohort_key",
              "protocol",
              "started_at",
              "ended_at",
              "sample_count",
              "sample_ids",
              "coverage",
              "confidence",
              "metrics"
            ],
            "properties": {
              "cohort_id": {
                "type": "string",
                "minLength": 1
              },
              "cohort_key": {
                "type": "string",
                "minLength": 1
              },
              "protocol": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://cloudeyes.dev/schemas/protocol/manifest.schema.json",
                "title": "CloudEyes Protocol Identity",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "version",
                  "fingerprint"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fingerprint": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "ended_at": {
                "type": "string",
                "format": "date-time"
              },
              "sample_count": {
                "type": "integer",
                "minimum": 1
              },
              "sample_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "coverage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sample_count",
                  "observation_days",
                  "regions",
                  "zones",
                  "products",
                  "plans",
                  "available_metrics",
                  "expected_metrics",
                  "gaps"
                ],
                "properties": {
                  "sample_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observation_days": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "regions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "zones": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "plans": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "available_metrics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expected_metrics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "gaps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "confidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "measurement",
                  "statistical",
                  "coverage"
                ],
                "properties": {
                  "measurement": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "statistical": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "coverage": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "unit",
                    "direction",
                    "contributing_samples",
                    "raw_observations",
                    "statistics"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "higher_is_better",
                        "lower_is_better",
                        "neutral"
                      ]
                    },
                    "contributing_samples": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "raw_observations": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "statistics": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "count",
                        "minimum",
                        "maximum",
                        "mean",
                        "median",
                        "standard_deviation",
                        "coefficient_of_variation",
                        "p10",
                        "p90"
                      ],
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "minimum": {
                          "type": "number"
                        },
                        "maximum": {
                          "type": "number"
                        },
                        "mean": {
                          "type": "number"
                        },
                        "median": {
                          "type": "number"
                        },
                        "standard_deviation": {
                          "type": "number",
                          "minimum": 0
                        },
                        "coefficient_of_variation": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "p10": {
                          "type": "number"
                        },
                        "p90": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "peerComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "peer_group_id",
        "peer_key",
        "profile",
        "metric_name",
        "unit",
        "direction",
        "provider_value",
        "peer_median",
        "relative_difference_percent",
        "outcome",
        "confidence",
        "peer_provider_count",
        "peer_provider_ids",
        "provider_cohort_ids",
        "peer_cohort_ids"
      ],
      "properties": {
        "comparison_id": {
          "type": "string",
          "pattern": "^peer-comparison-[0-9a-f]{16}$"
        },
        "peer_group_id": {
          "type": "string",
          "pattern": "^peer-group-[0-9a-f]{16}$"
        },
        "peer_key": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "provider_value": {
          "type": "number"
        },
        "peer_median": {
          "type": "number"
        },
        "relative_difference_percent": {
          "type": "number"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ahead",
            "similar",
            "behind"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "peer_provider_count": {
          "type": "integer",
          "minimum": 1
        },
        "peer_provider_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_cohort_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "peer_cohort_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pricingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "reference"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "official_api",
            "official_document",
            "reseller",
            "manual"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pricingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pricing_evidence_id",
        "quote_id",
        "provider_id",
        "product",
        "plan",
        "region",
        "zone",
        "commitment",
        "operating_system",
        "observed_at",
        "valid_from",
        "valid_until",
        "source_amount",
        "source_currency",
        "billing_period",
        "billing_period_hours",
        "fx_to_usd",
        "hourly_usd",
        "tax_included",
        "source",
        "confidence",
        "cohort_ids",
        "sample_ids"
      ],
      "properties": {
        "pricing_evidence_id": {
          "type": "string",
          "pattern": "^pricing-evidence-[0-9a-f]{16}$"
        },
        "quote_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "commitment": {
          "type": "string",
          "enum": [
            "on_demand",
            "reserved",
            "spot"
          ]
        },
        "operating_system": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "other"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billing_period": {
          "type": "string",
          "minLength": 1
        },
        "billing_period_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fx_to_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hourly_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tax_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/pricingSource"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "cohort_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sample_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "valueComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "peer_group_id",
        "peer_key",
        "profile",
        "metric_name",
        "metric_unit",
        "metric_direction",
        "index_definition",
        "provider_hourly_usd",
        "peer_hourly_usd_median",
        "provider_value_index",
        "peer_value_index_median",
        "relative_difference_percent",
        "outcome",
        "confidence",
        "peer_provider_count",
        "peer_provider_ids",
        "provider_cohort_ids",
        "peer_cohort_ids",
        "provider_pricing_evidence_ids",
        "peer_pricing_evidence_ids"
      ],
      "properties": {
        "comparison_id": {
          "type": "string",
          "pattern": "^value-comparison-[0-9a-f]{16}$"
        },
        "peer_group_id": {
          "type": "string",
          "pattern": "^peer-group-[0-9a-f]{16}$"
        },
        "peer_key": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_unit": {
          "type": "string",
          "minLength": 1
        },
        "metric_direction": {
          "type": "string",
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "index_definition": {
          "type": "string",
          "enum": [
            "metric_per_usd_hour",
            "inverse_metric_usd_hour"
          ]
        },
        "provider_hourly_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peer_hourly_usd_median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provider_value_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peer_value_index_median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relative_difference_percent": {
          "type": "number"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ahead",
            "similar",
            "behind"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "peer_provider_count": {
          "type": "integer",
          "minimum": 1
        },
        "peer_provider_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_cohort_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
