{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/discovery/hardware.schema.json",
  "title": "CloudEyes Hardware Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "logical_cpu_count",
    "physical_cpu_count",
    "memory_bytes",
    "cpu_model"
  ],
  "properties": {
    "architecture": {"type": "string", "minLength": 1},
    "logical_cpu_count": {"type": "integer", "minimum": 1},
    "physical_cpu_count": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "memory_bytes": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "cpu_model": {"type": ["string", "null"]}
  }
}
