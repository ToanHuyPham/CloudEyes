{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/pricing/catalog-v1.schema.json",
  "title": "CloudEyes Pricing Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quotes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "reference"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "official_api",
            "official_document",
            "reseller",
            "manual"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "provider_id",
        "product",
        "plan",
        "region",
        "zone",
        "observed_at",
        "valid_from",
        "valid_until",
        "commitment",
        "operating_system",
        "amount",
        "currency",
        "billing_period",
        "billing_period_hours",
        "fx_to_usd",
        "tax_included",
        "source"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "commitment": {
          "type": "string",
          "enum": [
            "on_demand",
            "reserved",
            "spot"
          ]
        },
        "operating_system": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "other"
          ]
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{3}$"
        },
        "billing_period": {
          "type": "string",
          "minLength": 1
        },
        "billing_period_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fx_to_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tax_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
