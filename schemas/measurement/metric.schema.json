{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/measurement/metric.schema.json",
  "title": "CloudEyes Metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "value",
    "unit",
    "direction"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "storage.random_read.iops"
      ]
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "iops",
        "bytes_per_second",
        "milliseconds"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "neutral"
      ]
    }
  }
}
