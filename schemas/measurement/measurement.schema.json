{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudeyes.dev/schemas/measurement/measurement.schema.json",
  "title": "CloudEyes Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "measurement_id",
    "tool",
    "tool_version",
    "profile",
    "protocol_version",
    "started_at",
    "finished_at",
    "status",
    "metrics",
    "raw_output_path",
    "error"
  ],
  "properties": {
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "skipped"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cloudeyes.dev/schemas/measurement/metric.schema.json",
        "title": "CloudEyes Metric",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "direction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "higher_is_better",
              "lower_is_better",
              "neutral"
            ]
          }
        }
      }
    },
    "raw_output_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
